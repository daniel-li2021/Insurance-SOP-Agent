# Copy to .env. Never commit .env or include it in an image.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# scripted runs entirely offline. live requires a configured key.
MODEL_MODE=scripted
DATA_DIR=data
DAILY_TOKEN_LIMIT=200000
# For public HTTPS hosting: APP_ENV=production and exact deployed origin(s).
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# Optional Fernet key. If omitted, a private key is generated in DATA_DIR/session.key.
# Keep that key with database backups. Changing it makes old sessions unreadable.
SESSION_ENCRYPTION_KEY=
